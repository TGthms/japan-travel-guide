{
  "name": "japan-travel-guide",
  "version": "2.0.0",
  "private": true,
  "description": "Japan Travel Guide: static multi-page site for Cloudflare Pages (primary) + GitHub Pages backup",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "serve:node": "npx --yes serve -l 8000 .",
    "generate:cities": "python3 scripts/generate_city_pages.py",
    "build:pages": "python3 scripts/build_pages.py",
    "smoke": "node scripts/smoke-check.mjs",
    "test:weather": "node scripts/test-weather-contract.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "travel",
    "japan",
    "static-site",
    "github-pages"
  ],
  "license": "MIT",
  "author": "Tim G (TGthms)"
}
